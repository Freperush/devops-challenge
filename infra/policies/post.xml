<policies>
  <inbound>
    <base />
    <check-header name="X-Parse-REST-API-Key" failed-check-httpcode="401" failed-check-error-message="unauthorized" ignore-case="false">
      <value>{{api-key}}</value>
    </check-header>
    <validate-jwt header-name="X-JWT-KWY" failed-validation-httpcode="401" failed-validation-error-message="unauthorized" require-expiration-time="true" require-signed-tokens="true" clock-skew="30">
      <issuer-signing-keys>
        <key>{{jwt-signing-key}}</key>
      </issuer-signing-keys>
      <audiences>
        <audience>devops-api</audience>
      </audiences>
      <issuers>
        <issuer>devops-challenge</issuer>
      </issuers>
    </validate-jwt>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
